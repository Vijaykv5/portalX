{
  "name": "@vijaykv/portalx",
  "version": "0.1.5",
  "description": "Share localhost apps with public URLs from your terminal.",
  "module": "index.ts",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "tunnel",
    "localhost",
    "ngrok",
    "websocket",
    "cli",
    "cloudflare"
  ],
  "bin": {
    "portalx": "dist/portalx.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "bun": ">=1.0.0"
  },
  "scripts": {
    "build:cli": "bun build apps/cli/src/index.ts --target=bun --outfile=dist/portalx.js",
    "prepack": "bun run build:cli",
    "server": "bun run apps/server/src/index.ts",
    "cli": "bun run apps/cli/src/index.ts",
    "portalx": "bun run apps/cli/src/index.ts",
    "worker:dev": "bunx wrangler dev",
    "worker:deploy": "bunx wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test:smoke": "bun run scripts/smoke-test.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "wrangler": "^4.130.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "ngrok": "^5.0.0-beta.2"
  }
}
